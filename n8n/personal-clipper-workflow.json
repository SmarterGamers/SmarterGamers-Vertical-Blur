    {
      "parameters": {
        "jsCode": "// Map whatever trigger fired into { path: <Windows path for the runner>, original: <basename>, trigger: <which> }\nconst cfg = $('Config').first().json;\nconst j = $input.first().json;\n\nlet raw = null;\nlet trigger = 'manual';\nif (j.path && typeof j.path === 'string' && !j.body) {\n  raw = j.path; trigger = 'file';                 // Local File Trigger → { event, path }\n} else if (j.body && j.body.path) {\n  raw = j.body.path; trigger = 'webhook';         // Webhook → { body: { path } }\n} else {\n  raw = cfg.MANUAL_PATH; trigger = 'manual';      // Manual Trigger → Config.MANUAL_PATH\n}\nif (!raw) throw new Error('No input path. Set Config.MANUAL_PATH or POST {\"path\": ...} to the webhook.');\n\n// Container path → Windows path (only when the path starts with CONTAINER_INBOX).\nlet winPath = raw;\nconst cInbox = (cfg.CONTAINER_INBOX || '').replace(/\\/+$/, '');\nif (cInbox && raw.startsWith(cInbox + '/')) {\n  const rel = raw.slice(cInbox.length + 1).replace(/\\//g, '\\\\');\n  winPath = cfg.INBOX.replace(/\\\\+$/, '') + '\\\\' + rel;\n}\nconst original = winPath.split(/[\\\\/]/).pop();\nreturn [{ json: { path: winPath, raw_path: raw, original, trigger } }];\n"
      },
